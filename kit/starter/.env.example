# The store's key from Settings › Website: a test key (frs_test_…) while you build, the live key (frs_pub_…) once the
# store opens. Server only: never NEXT_PUBLIC_, never in a file git tracks.
FRRATA_KEY=
# The API's address. Leave as is.
FRRATA_API_ORIGIN=https://api.frrata.shop
# Only with a build key (from Studio, a preview or `npx frrata dev`): sends the key in the Frrata-Key header. Leave empty otherwise.
FRRATA_KEY_MODE=
