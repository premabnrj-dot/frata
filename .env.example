# Names only. Values live in Vercel (Project → Settings → Environment Variables).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
# frata_admin.<ref> — Admin's cross-tenant connection. Production only (ADR-0007).
ADMIN_DATABASE_URL=
CRON_SECRET=
# Encrypts each shop's Razorpay keys and signs order links. Production only; changing it means shops reconnect Razorpay.
PAYMENT_KEYS_SECRET=
# Trials: the key of the one-trial-per-business HMACs (Production only; never change it once set)
TRIAL_CLAIM_SECRET=
# Frrata's own WhatsApp number for sign-up codes (these three and TRIAL_CLAIM_SECRET set = the code step is on; Production only)
FRRATA_WA_PHONE_NUMBER_ID=
FRRATA_WA_TOKEN=
FRRATA_WA_SIGNUP_TEMPLATE=
FRRATA_WA_TEMPLATE_LANG=
# Only for the local end-to-end test (a stand-in Razorpay). Never set in Vercel.
RAZORPAY_API_BASE=
# The console's own host, e.g. app.frata.in. Every other host is a storefront.
NEXT_PUBLIC_CONSOLE_HOST=
# The domain every shop's subdomain sits under (owner call, Phase 1). Default frata.store.
NEXT_PUBLIC_SHOP_DOMAIN=
# Vercel Blob store frata-blob — photos and logos (ADR-0005). Added by connecting the store.
BLOB_READ_WRITE_TOKEN=
# frata-blob's store id (store_…), added with the token: photos must come from this store's host.
BLOB_STORE_ID=

# Messages (WhatsApp). Frrata's Meta app (Tech Provider): its id and Embedded Signup config id are public;
# the app secret signs webhooks and exchanges signup codes. Production only.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WA_CONFIG_ID=
META_APP_SECRET=
# Any random string; paste the same in the Meta app's webhook settings.
WA_VERIFY_TOKEN=
# Only for the local end-to-end test (a stand-in Graph API). Never set in Vercel.
META_GRAPH_BASE=

# Test only: the e2e stack sets 1 to serve /console/fixtures/ui (e2e/stack.mjs). Never set in Vercel.
E2E_FIXTURES=

# Set by Next itself during `next build` (never by hand): the public pages fall back to no prices only then.
NEXT_PHASE=

# Frrata's own GSTIN (billing; its state decides CGST+SGST or IGST). Unset in test mode.
FRRATA_GSTIN=
FRRATA_LEGAL_NAME=
FRRATA_ADDRESS=
FRRATA_SAC=
RAZORPAY_BILLING_KEY_ID=
RAZORPAY_BILLING_KEY_SECRET=
RAZORPAY_BILLING_WEBHOOK_SECRET=
RAZORPAY_BILLING_WEBHOOK_SECRET_PREVIOUS=
BILLING_TEST_ISSUE=

# GST filing from Frrata (GST app G2). Unset = off. "fake" = the in-process stand-in for tests; refused in Production.
GSP_PROVIDER=

# Own domains (shop addresses D·2). Production only; unset = own domains off.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_API_BASE=
DOH_BASE=
DOMAIN_CAPACITY=
# Mux video (V1): Production only, Sensitive; none in Preview while previews share the database.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Kept while a new Mux webhook replaces the old one (rotation), then emptied.
MUX_WEBHOOK_SECRET_PREVIOUS=
# The Mux environment the token belongs to (Settings › Environments in Mux; not a secret).
MUX_ENVIRONMENT_ID=
# e2e only (the fake Mux); ignored in Production.
MUX_API_BASE=
MUX_STREAM_BASE=
MUX_IMAGE_BASE=
# EkCode (docs/setup.md § EkCode): its host, number, Meta app and key rings. Production only.
NEXT_PUBLIC_EKCODE_HOST=
EKCODE_WA_PHONE_NUMBER_ID=
EKCODE_WA_TOKEN=
EKCODE_WA_AUTH_TEMPLATE=
EKCODE_WA_TEMPLATE_LANG=
EKCODE_WA_VERIFY_TOKEN=
EKCODE_META_APP_SECRET=
EKCODE_PHONE_PEPPERS=
EKCODE_SEAL_KEYS=
